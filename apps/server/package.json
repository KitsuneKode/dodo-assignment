{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"wrangle:dev": "wrangler dev src/index.ts",
		"deploy": "wrangler deploy src/index.ts --minify -e production",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@dodo-assignment/api": "workspace:*",
		"@dodo-assignment/auth": "workspace:*",
		"@dodo-assignment/db": "workspace:*",
		"@hono/trpc-server": "^0.4.0",
		"@trpc/server": "catalog:",
		"@upstash/ratelimit": "^2.0.7",
		"@upstash/redis": "^1.35.6",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"wrangler": "^4.50.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@types/bun": "^1.3.3",
		"tsdown": "^0.16.5"
	}
}
